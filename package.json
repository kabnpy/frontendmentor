{
  "name": "frontend-mentor-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'Use: pnpm dev:[project-name]'",
    "build": "pnpm run clean && pnpm -r --filter './projects/**' run build && pnpm run post-build",
    "post-build": "node scripts/generate-sitemap.js && node scripts/generate-project-index.js",
    "preview": "pnpm run build && npx serve dist -p 3000",
    "clean": "rimraf dist && pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,astro}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,astro}\""
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "prettier-plugin-astro": "^0.12.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}