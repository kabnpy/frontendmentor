---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'destinations' | 'crew' | 'technology'>[];
  group: 'destination' | 'crew' | 'technology';
  class?: string;
}

const { items, group, class: className } = Astro.props;

const listClass = {
  destination: 'tab-list underline-indicators',
  crew: 'dot-indicators',
  technology: 'numbered-tabs',
}[group];
---

<tabs-component class:list={['tabs-container', className]} data-group={group}>
  <ul role="tablist" class={listClass}>
    {
      items.map((item, index) => (
        <li role="presentation">
          <a
            role="tab"
            id={`${group}-tab-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`${group}-${index}`}
            href={`#${group}-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-name={item.data.name}
          >
            {group === 'technology' ? (
              index + 1
            ) : group === 'crew' ? (
              <span class="sr-only">{item.data.name}</span>
            ) : (
              item.data.name
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <slot />
</tabs-component>

<script>
  class Tabs extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      const tablist = this.querySelector('[role="tablist"]');
      if (!tablist) return;

      const tabs = Array.from(this.querySelectorAll('[role="tab"]'));
      const panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
      const group = this.dataset.group;

      // Make panels focusable for screen readers
      panels.forEach((panel) => {
        if (panel instanceof HTMLElement) {
          panel.tabIndex = -1;
        }
      });

      tablist.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;

        const anchor = target.closest('a[role="tab"]');
        if (!anchor) return;

        e.preventDefault();
        const targetTab = anchor as HTMLAnchorElement;

        this.switchTab(targetTab, tabs, panels, group);
      });

      // Enable keyboard navigation
      tablist.addEventListener('keydown', (e) => {
        const event = e as KeyboardEvent;
        const targetTab = (event.target as HTMLElement).closest('a[role="tab"]');
        if (!targetTab) return;

        const index = tabs.indexOf(targetTab);
        let newIndex: number | null = null;
        let shouldFocusPanel = false;

        // Arrow key navigation
        if (event.key === 'ArrowRight') {
          newIndex = index + 1;
          if (newIndex >= tabs.length) newIndex = 0;
        } else if (event.key === 'ArrowLeft') {
          newIndex = index - 1;
          if (newIndex < 0) newIndex = tabs.length - 1;
        } else if (event.key === 'ArrowDown') {
          // Down arrow focuses the panel for screen reader users
          shouldFocusPanel = true;
        }

        if (shouldFocusPanel) {
          event.preventDefault();
          const panelId = targetTab.getAttribute('aria-controls');
          if (panelId) {
            const panel = this.querySelector(`#${panelId}`) as HTMLElement;
            if (panel) {
              panel.focus();
            }
          }
        } else if (newIndex !== null) {
          event.preventDefault();
          const newTab = tabs[newIndex] as HTMLElement;
          this.switchTab(newTab, tabs, panels, group);
          newTab.focus();
        }
      });
    }

    switchTab(targetTab: Element, tabs: Element[], panels: Element[], group: string | undefined) {
      const selectedTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
      const selectedPanel = panels.find((panel) => !(panel as HTMLElement).hidden);

      if (selectedTab === targetTab) return;

      // Deactivate old tab
      if (selectedTab instanceof HTMLElement) {
        selectedTab.setAttribute('aria-selected', 'false');
        selectedTab.tabIndex = -1;

        // Hide old image
        const oldImageName = selectedTab.dataset.name;
        if (oldImageName && group) {
          const oldImage = document.querySelector(`[data-${group}-image="${oldImageName}"]`);
          if (oldImage instanceof HTMLElement) {
            oldImage.hidden = true;
          }
        }
      }

      // Hide old panel
      if (selectedPanel instanceof HTMLElement) {
        selectedPanel.hidden = true;
      }

      // Activate new tab
      if (targetTab instanceof HTMLElement) {
        targetTab.setAttribute('aria-selected', 'true');
        targetTab.tabIndex = 0;

        const panelId = targetTab.getAttribute('aria-controls');
        if (panelId) {
          const panel = this.querySelector(`#${panelId}`);
          if (panel instanceof HTMLElement) {
            panel.hidden = false;
          }
        }

        // Show new image
        const newImageName = targetTab.dataset.name;
        if (newImageName && group) {
          const newImage = document.querySelector(`[data-${group}-image="${newImageName}"]`);
          if (newImage instanceof HTMLElement) {
            newImage.hidden = false;
          }
        }
      }
    }
  }

  customElements.define('tabs-component', Tabs);
</script>

<style>
  [role='tablist'] {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: var(--gap, 1rem);
  }

  [role='tablist'] a {
    text-decoration: none;
  }

  /* Focus styles for panels (for screen reader users) */
  [role='tabpanel']:focus {
    outline: none;
  }

  /* Destination Tabs */
  .tab-list a {
    cursor: pointer;
    display: block;
    padding: var(--underline-gap, 1rem) 0;
    border: 0;
    border-bottom: 0.2rem solid hsl(var(--colour-white) / 0);
    transition: all 350ms ease-in-out;
    color: inherit;
    text-transform: uppercase;
    letter-spacing: 2.7px;
  }

  .tab-list a:hover,
  .tab-list a:focus {
    border-color: hsl(var(--colour-white) / 0.5);
  }

  .tab-list a[aria-selected='true'] {
    color: hsl(var(--colour-white) / 1);
    border-color: hsl(var(--colour-white) / 1);
  }

  /* Crew Tabs */
  .dot-indicators a {
    cursor: pointer;
    border-radius: 50%;
    width: 1rem;
    aspect-ratio: 1;
    display: inline-block;
    background-color: hsl(var(--colour-white) / 0.25);
    transition: background-color 350ms ease-in-out;
  }

  .dot-indicators a:hover,
  .dot-indicators a:focus {
    background-color: hsl(var(--colour-white) / 0.5);
  }

  .dot-indicators a[aria-selected='true'] {
    background-color: hsl(var(--colour-white) / 1);
  }

  /* Technology Tabs */
  .numbered-tabs a {
    cursor: pointer;
    border: 1px solid hsl(var(--colour-white) / 0.25);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-content: center;
    transition: all 350ms ease-in-out;
    color: hsl(var(--colour-white));
    text-decoration: none;
  }

  @media (min-width: 45em) {
    .numbered-tabs a {
      width: 3.75rem;
      height: 3.75rem;
    }

    .dot-indicators a {
      width: 1.5rem;
    }
  }

  .numbered-tabs a:hover,
  .numbered-tabs a:focus {
    border-color: hsl(var(--colour-white) / 1);
  }

  .numbered-tabs a[aria-selected='true'] {
    background-color: hsl(var(--colour-white) / 1);
    color: hsl(var(--colour-dark) / 1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
