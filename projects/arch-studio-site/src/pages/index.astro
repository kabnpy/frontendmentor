---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured } from "../data/index.ts";

const heroSlides = [
  {
    title: 'Project Paramour',
    copy: 'Project made for an art museum near Southwest London. Project Paramour is a statement of bold, modern architecture.',
    imageUrl: {
      mobile: '/assets/home/mobile/image-hero-paramour.jpg',
      tablet: '/assets/home/tablet/image-hero-paramour.jpg',
      desktop: '/assets/home/desktop/image-hero-paramour.jpg',
    },
    ctaHref: '/portfolio',
    ctaLabel: 'See Our Portfolio',
  },
  {
    title: 'Seraph Station',
    copy: 'A showcase of minimalist design and modern structure.',
    imageUrl: {
      mobile: '/assets/home/mobile/image-hero-seraph.jpg',
      tablet: '/assets/home/tablet/image-hero-seraph.jpg',
      desktop: '/assets/home/desktop/image-hero-seraph.jpg',
    },
    ctaHref: '/portfolio',
  },
  {
    title: 'Federal II Tower',
    copy: 'A bold statement of vertical elegance in the city skyline.',
    imageUrl: {
      mobile: '/assets/home/mobile/image-hero-federal.jpg',
      tablet: '/assets/home/tablet/image-hero-federal.jpg',
      desktop: '/assets/home/desktop/image-hero-federal.jpg',
    },
    ctaHref: '/portfolio',
  },
  {
    title: 'Trinity Bank Tower',
    copy: 'A refined blend of symmetry and function.',
    imageUrl: {
      mobile: '/assets/home/mobile/image-hero-trinity.jpg',
      tablet: '/assets/home/tablet/image-hero-trinity.jpg',
      desktop: '/assets/home/desktop/image-hero-trinity.jpg',
    },
    ctaHref: '/portfolio',
  },
];
---

<Layout>
    <main>
        <div class="wrapper flow p-responsive">
            <section class="section-hero">
                <picture class="section-hero__image">
                    <source
                        srcset="/assets/home/desktop/image-hero-paramour.jpg"
                        media="(min-width: 1024px)"
                    />
                    <source
                        srcset="/assets/home/tablet/image-hero-paramour.jpg"
                        media="(min-width: 768px)"
                    />
                    <img src="/assets/home/mobile/image-hero-paramour.jpg" alt="" />
                </picture>
                <div class="section-hero__content content-overlay text-white flow">
                    <h2 class="fs-02">Project Paramour</h2>
                    <p>
                        Project made for an art museum near Southwest London.
                        Project Paramour is a statement of bold, modern
                        architecture.
                    </p>
                    <a href="/portfolio" class="button">
                        See Our Portfolio
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="26"
                            height="20"
                            ><g
                                fill="none"
                                fill-rule="evenodd"
                                stroke="currentColor"
                                stroke-width="2"
                                ><path d="M15 1l10 9-10 9M0 10h24"></path></g
                            ></svg
                        >
                    </a>
                </div>
                <ul role="list" class="section-hero__pagination">
                    <li><a href="" aria-selected="true">01</a></li>
                    <li><a href="">02</a></li>
                    <li><a href="">03</a></li>
                    <li><a href="">04</a></li>
                </ul>
            </section>
        </div>
        <div class="wrapper flow p-responsive">
            <section class="section-welcome flow">
                <h1 class="fs-04 text-very-light-grey section-welcome__heading">Welcome</h1>
                <div class="section-welcome__content flow">
                    <h2 class="fs-02">Welcome to<br />Arch Studio</h2>
                    <p>
                        We have a unique network and skillset to help bring your
                        projects to life. Our small team of highly skilled individuals
                        combined with our large network put us in a strong position to
                        deliver exceptional results.
                    </p>
                    <p>
                        Over the past 10 years, we have worked on all kinds of projects.
                        From stations to high-rise buildings, we create spaces that
                        inspire and delight.
                    </p>
                    <p>
                        We work closely with our clients so that we understand the
                        intricacies of each project. This allows us to work in harmony
                        the surrounding area to create truly stunning projects that will
                        stand the test of time.
                    </p>
                </div>
                <img src="/assets/home/desktop/image-welcome.jpg" class="section-welcome__image"/>
            </section>
        </div>
        <div class="wrapper flow">
            <section class="section-about">
                <picture class="section-about__image">
                    <source
                        srcset="/assets/home/desktop/image-small-team.jpg"
                        media="(min-width: 1024px)"
                    />
                    <source
                        srcset="/assets/home/tablet/image-small-team.jpg"
                        media="(min-width: 768px)"
                    />
                    <img src="/assets/home/mobile/image-small-team.jpg" alt="" />
                </picture>
                <div class="section-about__content content-overlay flow">
                    <h2 class="fs-03 text-white">
                        Small team,<br />big ideas
                    </h2>
                    <a href="/about" class="button">
                        About Us
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="26"
                            height="20"
                            ><g
                                fill="none"
                                fill-rule="evenodd"
                                stroke="currentColor"
                                stroke-width="2"
                                ><path d="M15 1l10 9-10 9M0 10h24"></path></g
                            ></svg
                        >
                    </a>
                </div>
            </section>
        </div>
        <div class="wrapper flow p-responsive">
            <section class="section-featured flow">
                <h2 class="fs-03 section-featured__title">Featured</h2>
                <div class="projects section-featured__projects">
                    {featured.map((project, index) => <ProjectCard {...project} index={(index + 1).toString()} featured />)}
                </div>
<a href="/portfolio" class="button section-featured__action">
                    See All
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="20"
                        ><g
                            fill="none"
                            fill-rule="evenodd"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path d="M15 1l10 9-10 9M0 10h24"></path></g
                        ></svg
                    >
                </a>
            </section>
        </div>
    </main>
</Layout>
