---
import Layout from '../layouts/Layout.astro';
import paintings from '../content/paintings.json';
import GalleryCard from '../components/GalleryCard.astro';
---

<Layout class="home-page">
  <div class="masonry">
    {
      paintings.map((painting) => (
        <GalleryCard
          slug={painting.slug}
          imageUrl={painting.images.thumbnail}
          title={painting.name}
          artist={painting.artist.name}
        />
      ))
    }
  </div>
</Layout>

