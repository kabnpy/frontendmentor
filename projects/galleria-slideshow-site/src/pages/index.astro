---
import Layout from '../layouts/Layout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getCollection } from 'astro:content';

const paintings = await getCollection('paintings');
---

<Layout>
  <main class="masonry hidden" id="grid" data-mason-it>
    {
      paintings.map((painting) => (
        <GalleryCard
          slug={painting.data.slug}
          image={painting.data.images.thumbnail}
          title={painting.data.name}
          artist={painting.data.artist.name}
        />
      ))
    }
  </main>
</Layout>

<style>
  main {
    padding: var(--spacing-400);
  }

  .masonry {
    display: grid;
    overflow: hidden;
    gap: var(--spacing-400);
    grid-auto-rows: min-content;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    transition: opacity 0.3s ease;
  }

  .hidden {
    opacity: 0;
  }
</style>

<script type="module">
  import { BalancedMasonryGrid } from 'https://cdn.skypack.dev/@masonry-grid/vanilla';
  const grid = document.getElementById('grid');
  grid.classList.remove('hidden');
  new BalancedMasonryGrid(grid);
</script>
