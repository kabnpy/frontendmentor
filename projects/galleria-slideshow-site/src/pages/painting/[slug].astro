---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ViewImageIcon from '../../assets/shared/icon-view-image.svg';
import Dialog from '../../components/Dialog.astro';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const paintings = await getCollection('paintings');

  return paintings.map((painting, index) => ({
    params: { slug: painting.data.slug },
    props: {
      painting,
      currentIndex: index,
      totalSlides: paintings.length,
      allPaintings: paintings,
    },
  }));
}

const { painting, currentIndex, totalSlides, allPaintings } = Astro.props;
const prevSlug = currentIndex > 0 ? allPaintings[currentIndex - 1].data.slug : undefined;
const nextSlug =
  currentIndex < totalSlides - 1 ? allPaintings[currentIndex + 1].data.slug : undefined;
---

<Layout
  paintingTitle={painting.data.name}
  artistName={painting.data.artist.name}
  currentIndex={currentIndex}
  totalSlides={totalSlides}
  prevSlug={prevSlug}
  nextSlug={nextSlug}
>
  <main>
    <div class="hero">
      <div class="hero-image">
        <picture>
          <source srcset={painting.data.images.hero.large} media="(width >= 800px)" />
          <img
            src={painting.data.images.hero.small}
            alt={`A view of ${painting.data.name}`}
            transition:name={`painting-${painting.data.slug}`}
          />
        </picture>
        <button type="button" class="view-image-button">
          <ViewImageIcon />
          <span>view image</span>
        </button>
      </div>
      <div class="hero-meta" transition:name={`meta-${painting.data.slug}`}>
        <h2>{painting.data.name}</h2>
        <p>{painting.data.artist.name}</p>
      </div>
      <div class="hero-artist" transition:name={`artist-${painting.data.slug}`}>
        <Image src={painting.data.artist.image} alt={painting.data.artist.name} />
      </div>
    </div>
    <div class="content">
      <div class="content-year">{painting.data.year}</div>
      <p>{painting.data.description}</p>
      <a
        href={painting.data.source}
        target="_blank"
        rel="noopener noreferrer"
        class="slideshow-source">Go to source</a
      >
    </div>
  </main>

  <Dialog image={painting.data.images.gallery} title={painting.data.name} />
</Layout>

<script>
  const viewImageBtn = document.querySelector('.view-image-button');
  const dialog = document.querySelector('.image-dialog') as HTMLDialogElement;

  if (viewImageBtn && dialog) {
    viewImageBtn.addEventListener('click', () => {
      dialog.showModal();
    });
  }
</script>

<style>
  main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15vw;
    padding: 2rem;
  }

  .hero {
    display: grid;
    grid-template-rows: 1fr var(--spacing-700) auto auto;
    grid-template-columns: 1fr;
  }

  .hero-image {
    grid-row: 1/3;
    grid-column: 1/2;
    position: relative;
  }

  .view-image-button {
    position: absolute;
    left: var(--spacing-100);
    top: var(--spacing-100);
    background-color: hsl(var(--color-black) / 0.75);
    color: hsl(var(--color-white));
    border: none;
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 2.14px;
    font-size: var(--font-size-07);
    cursor: pointer;
    z-index: 1;
    transition: background-color 0.3s;
  }

  .view-image-button span {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
  }

  .view-image-button:is(:hover, :focus-visible) {
    background-color: hsl(var(--color-black));
  }

  .hero-meta {
    grid-row: 2/4;
    grid-column: 1/2;
    padding-block: var(--spacing-300);
    background: hsl(var(--color-white));
    width: 85%;
    z-index: 5;
  }

  .hero-meta h2 {
    font-size: var(--font-size-02);
  }

  .hero-meta p {
    color: hsl(var(--color-grey-400));
    font-size: var(--font-size-04);
  }

  .hero-artist {
    grid-row: 4;
    grid-column: 1/2;
  }

  .content {
    position: relative;
    color: hsl(var(--color-grey-400));
    font-weight: 700;
  }

  .content p {
    margin-block-end: 3rem;
  }

  .content a {
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -0.25px;
    font-size: var(--font-size-04);
  }

  .content-year {
    font-size: var(--font-size-01);
    color: hsl(var(--color-grey-100));
    position: absolute;
    right: 0;
    transform: translateY(-50%);
    z-index: -1;
  }

  @media (min-width: 48em) {
    .view-image-button {
      top: unset;
      bottom: var(--spacing-100);
    }

    .hero {
      grid-template-rows: auto 1fr;
      grid-template-columns: 1fr 1fr auto;
    }

    .hero-image {
      grid-row: 1/3;
      grid-column: 1/3;
    }

    .hero-meta {
      padding: 0 var(--spacing-700) var(--spacing-700) var(--spacing-700);
      grid-row: 1/2;
      grid-column: 2/4;
    }

    .hero-artist {
      grid-row: 2/4;
      grid-column: 3;
      margin-inline-start: var(--spacing-300);
    }

    .content {
      justify-self: center;
      max-width: 35ch;
    }

    .content-year {
      right: unset;
      left: -25%;
      transform: translateY(-30%);
    }
  }

  @media (min-width: 64em) {
    main {
      gap: 3rem;
      grid-template-columns: 1fr minmax(auto, 30ch);
      align-items: center;
      justify-content: center;
      max-width: 90rem;
      margin-inline: auto;
    }

    .hero {
      margin-inline: auto;
      grid-template-rows: auto 1fr 4rem;
      grid-template-columns: 1fr var(--spacing-700) 1fr;
    }

    .hero-image {
      grid-row: 1/3;
      grid-column: 1/3;
    }

    .hero-meta {
      grid-row: 1/2;
      grid-column: 2/4;
    }

    .hero-artist {
      grid-row: 2/4;
      grid-column: 3;
      align-self: end;
    }

    .content {
      max-width: 30ch;
    }

    .content-year {
      left: unset;
      right: -30%;
      transform: translateY(-50%);
    }
  }
</style>
