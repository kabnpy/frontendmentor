---
import '@frontend-mentor/css-reset';
import '../styles/global.css';

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';

interface Props {
  paintingTitle?: string;
  artistName?: string;
  currentIndex?: number;
  totalSlides?: number;
  prevSlug?: string;
  nextSlug?: string;
}

const { paintingTitle, artistName, currentIndex, totalSlides, prevSlug, nextSlug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-32x32.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    {paintingTitle && artistName && currentIndex !== undefined && totalSlides !== undefined && (
      <Footer
        paintingTitle={paintingTitle}
        artistName={artistName}
        currentIndex={currentIndex}
        totalSlides={totalSlides}
        prevSlug={prevSlug}
        nextSlug={nextSlug}
      />
    )}
  </body>
</html>
