---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  image: ImageMetadata;
  title: string;
  artist: string;
}

const { slug, image, title, artist } = Astro.props;
const { width, height } = image;
---

<article class="gallery-card frame" style={`--width: ${width}; --height: ${height};`}>
  <a href={`/painting/${slug}`}>
    <Image
      src={image}
      alt={title}
      class="gallery-card__image"
    />
    <div class="gallery-card__meta">
      <h2>{title}</h2>
      <h3>{artist}</h3>
    </div>
  </a>
</article>

<style>
  .gallery-card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: var(--width) / var(--height);
  }

  .gallery-card a {
    display: block;
    height: 100%;
  }

  .gallery-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease-in-out;
  }

  .gallery-card__meta {
    position: absolute;
    inset: 0 0 0 0;
    padding: var(--spacing-500);
    display: flex;
    flex-direction: column;
    justify-content: end;
    color: hsl(var(--color-white));
    background: var(--gradient);
  }

  .gallery-card:is(:hover, :focus-within) .gallery-card__image {
    transform: scale(1.05);
  }
</style>
