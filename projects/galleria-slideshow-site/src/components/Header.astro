---
import Logo from '../assets/shared/logo.svg';
---

<header>
  <a href="/">
    <Logo />
  </a>
  <button type="button">start slideshow</button>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-400);
    border-bottom: 1px solid hsl(var(--color-grey-150));
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--font-size-04);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: hsl(var(--color-grey-400));
  }
  @media (min-width: 50em) {
    header {
      padding-inline: 0;
      margin-inline: var(--spacing-400);
    }
  }
</style>
