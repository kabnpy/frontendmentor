---
import logo from '../assets/shared/logo.svg';
---

<header>
  <a href="/">
    <img src={logo.src} alt="Galleria" width={logo.width} height={logo.height} />
  </a>
  <button type="button">start slideshow</button>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-400);
    border-bottom: 1px solid hsl(var(--color-grey-400));
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--font-size-06);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: hsl(var(--color-grey-400));
  }
</style>
